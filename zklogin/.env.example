# zkLogin tool configuration — copy to zklogin/.env
#
# Every transaction is signed as your EVE Frontier game account on Sui testnet.
# Salt and ZK proof come from Enoki; this must be the same Enoki app EVE Vault
# uses, or you'll log in as a different address than the one that owns your
# character (the tool checks this against ZKLOGIN_ADDRESS in the repo-root .env).

# EVE Frontier OAuth for the live tier
AUTH_URL=
CLIENT_ID=

# Enoki public API key (https://portal.enoki.mystenlabs.com/)
ENOKI_API_KEY=

# Optional: override the testnet fullnode
# SUI_NETWORK_URL=https://fullnode.testnet.sui.io:443
