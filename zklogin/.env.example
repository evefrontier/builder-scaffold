# zkLogin tool configuration — copy to zklogin/.env
#
# Every transaction is signed as your EVE Frontier game account on Sui testnet.
# Your address and ZK proof come from the EVE Frontier API — the same endpoints
# EVE Vault uses — so you get the same address EVE Vault shows you (the tool
# checks it against ZKLOGIN_ADDRESS in the repo-root .env).

# EVE Frontier OAuth for the server TENANT points at in the repo-root .env (the
# live tier for the workshop). The tool stops if you log in to a different one.
AUTH_URL=
CLIENT_ID=

# Optional: override the EVE Frontier API gateway. By default it's derived from
# your login's tenant, e.g. https://api.live.pub.evefrontier.com
# EVE_API_URL=

# Optional: override the testnet fullnode
# SUI_NETWORK_URL=https://fullnode.testnet.sui.io:443
