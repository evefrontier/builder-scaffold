# ============================================
# WORKSHOP KIT — copy these from your kit card
# ============================================
# Your EVE Frontier game account's zkLogin address. Every transaction is sent
# from this address and signed in the zkLogin terminal (see zklogin/).
ZKLOGIN_ADDRESS=

# In-game item IDs (read them in the game, or from your kit card).
CHARACTER_ITEM_ID=
GATE_ITEM_ID_1=
GATE_ITEM_ID_2=
STORAGE_UNIT_ITEM_ID=

# Item type your gate accepts as a bounty, and how many to hand in.
CORPSE_TYPE_ID=
CORPSE_QUANTITY=1

# ============================================
# WORLD — leave as-is for the workshop
# ============================================
# Game server tenant; picks the world tier (see ts-scripts/mvr/tenants.ts):
#   stillness, liminality                   @evefrontier/world
#   utopia, umbra                           @evefrontier/world-uat
#   tauceti, tiaki, tetra, tesseract        @evefrontier/world-test
# Your zkLogin login (zklogin/.env) must be for the same tier.
TENANT=liminality
# SUI_RPC_URL=https://fullnode.testnet.sui.io:443

# ============================================
# YOUR PACKAGE — written by `pnpm record-publish`
# ============================================
BUILDER_PACKAGE_ID=
EXTENSION_CONFIG_ID=

# ============================================
# OPTIONAL
# ============================================
# PERMIT_EXPIRY_MS=3600000
# Fallback rule with no inventory: RULE=tribe and TRIBE_ID=<your tribe>
# RULE=bounty
# TRIBE_ID=
